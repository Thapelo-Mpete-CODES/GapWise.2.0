@model GapWise.Web.ViewModels.DashboardViewModel
@{ ViewData["Title"]="Dashboard"; Layout="_Layout"; }
<div class="container py-4 py-md-5"><section class="hero-panel p-4 p-md-5 mb-4"><div class="row align-items-center g-4"><div class="col-lg-8"><p class="eyebrow">Your learning dashboard</p><h1 class="display-5 fw-bold mb-2">Hello, @Model.FirstName <span aria-hidden="true">👋</span></h1><p class="lead text-muted mb-4">Small focused steps create real exam confidence. Here’s where you are today.</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-light" asp-controller="Exam" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1"></i>Take a diagnostic</a><a class="btn btn-outline-light" asp-controller="Learning" asp-action="Index">Explore learning hub</a></div></div><div class="col-lg-4"><div class="bg-white bg-opacity-10 rounded-4 p-4"><span class="small text-white-50">Current focus</span><h2 class="h3 mt-1">@Model.WeakestTopic</h2><p class="text-muted mb-0">Your clearest opportunity for growth.</p></div></div></div></section><section class="row g-3 mb-4"><div class="col-6 col-xl-3"><article class="premium-card metric-card p-3 p-md-4 h-100"><span class="metric-icon"><i class="bi bi-trophy"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">Latest score</p><p class="metric-value h2 fw-bold mb-0">@(Model.LatestAssessmentScore is null ? "—" : $"{Model.LatestAssessmentScore}%")</p></article></div><div class="col-6 col-xl-3"><article class="premium-card metric-card p-3 p-md-4 h-100"><span class="metric-icon"><i class="bi bi-bar-chart"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">Average score</p><p class="metric-value h2 fw-bold mb-0">@(Model.AverageScore is null ? "—" : $"{Model.AverageScore}%")</p></article></div><div class="col-6 col-xl-3"><article class="premium-card metric-card p-3 p-md-4 h-100"><span class="metric-icon"><i class="bi bi-check2-circle"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">Diagnostics</p><p class="metric-value h2 fw-bold mb-0">@Model.AssessmentsCompleted</p></article></div><div class="col-6 col-xl-3"><article class="premium-card metric-card p-3 p-md-4 h-100"><span class="metric-icon"><i class="bi bi-lightning-charge"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">Status</p><p class="h5 fw-bold mb-0 text-primary">@Model.LearningStatus</p></article></div></section><div class="row g-4"><div class="col-lg-7"><section class="premium-card p-4 h-100"><div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow mb-1">Keep moving</p><h2 class="h3 mb-0">Your progress</h2></div><span class="badge text-bg-primary">@Model.LearningProgress%</span></div><div class="progress mb-3"><div class="progress-bar" style="width:@Model.LearningProgress%"></div></div><p class="text-muted mb-4">You’re building a stronger foundation with every completed learning activity.</p><div class="row g-3"><div class="col-sm-6"><div class="rounded-4 bg-light p-3"><i class="bi bi-award text-success fs-4"></i><p class="small text-muted mb-1 mt-2">Strongest topic</p><strong>@Model.StrongestTopic</strong></div></div><div class="col-sm-6"><div class="rounded-4 bg-light p-3"><i class="bi bi-bullseye text-primary fs-4"></i><p class="small text-muted mb-1 mt-2">Focus next</p><strong>@Model.WeakestTopic</strong></div></div></div></section></div><div class="col-lg-5"><section class="premium-card p-4 mb-4"><p class="eyebrow mb-1">Recommended next</p><h2 class="h4">Continue your learning</h2><p class="text-muted">@Model.LatestRecommendation</p><a class="btn btn-primary w-100" asp-controller="Learning" asp-action="Index">Open learning hub <i class="bi bi-arrow-right ms-1"></i></a></section><section class="premium-card p-4"><div class="d-flex align-items-center gap-3"><span class="feature-icon"><i class="bi bi-clock-history"></i></span><div class="flex-grow-1"><h2 class="h6 mb-1">Assessment history</h2><p class="small text-muted mb-0">Review your progress over time.</p></div><a class="btn btn-outline-primary btn-sm" asp-controller="Exam" asp-action="History">View</a></div></section></div></div></div>
