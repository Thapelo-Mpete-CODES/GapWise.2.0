@model GapWise.Web.ViewModels.AssessmentHistoryViewModel
@{ViewData["Title"]="Assessment history";Layout="_Layout";}
<div class="container py-4 py-md-5"><header class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-end mb-5"><div><p class="eyebrow">Your progress</p><h1 class="display-6 fw-bold mb-1">Assessment history</h1><p class="lead text-muted mb-0">See how your diagnostic confidence is growing.</p></div><a class="btn btn-primary" asp-action="Index"><i class="bi bi-plus-lg me-1"></i>New assessment</a></header><section class="premium-card overflow-hidden">@if(Model.Attempts.Count==0){<div class="text-center py-5"><i class="bi bi-clipboard2 fs-1 text-primary"></i><h2 class="h4 mt-3">Your story starts here</h2><p class="text-muted">Complete your first diagnostic to unlock a progress history.</p><a class="btn btn-primary" asp-action="Index">Start assessment</a></div>}else{<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Subject</th><th>Score</th><th>Strongest topic</th><th>Focus next</th><th>Status</th></tr></thead><tbody>@foreach(var attempt in Model.Attempts){<tr><td><strong>@attempt.DateTaken.ToString("dd MMM yyyy")</strong><br/><span class="small text-muted">@attempt.DateTaken.ToString("HH:mm")</span></td><td>@attempt.Subject</td><td><span class="badge text-bg-primary">@attempt.Percentage%</span></td><td>@attempt.StrongestTopic</td><td>@attempt.WeakestTopic</td><td><span class="badge text-bg-light border text-muted">@attempt.Status</span></td></tr>}</tbody></table></div>}</section></div>
