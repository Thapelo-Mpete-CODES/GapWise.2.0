@model GapWise.Web.ViewModels.ExamSetupViewModel
@{ViewData["Title"]="Start a diagnostic";Layout="_Layout";}
<div class="container py-4 py-md-5"><div class="row justify-content-center"><div class="col-xl-9"><header class="mb-4"><p class="eyebrow">Diagnostic assessment · Step 1 of 3</p><div class="progress mb-4"><div class="progress-bar" style="width:33%"></div></div><h1 class="display-6 fw-bold">Set up your assessment</h1><p class="lead text-muted">A few details help us tailor your diagnostic experience.</p></header><form asp-action="Index" method="post" class="premium-card p-4 p-md-5">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="row g-4"><div class="col-md-6"><label asp-for="Grade" class="form-label fw-bold">1. Your grade</label><select asp-for="Grade" class="form-select"><option value="">Select your grade</option><option>Grade 10</option><option>Grade 11</option><option>Grade 12</option></select><span asp-validation-for="Grade" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Subject" class="form-label fw-bold">2. Subject</label><select asp-for="Subject" class="form-select"><option value="">Select a subject</option><option>Mathematics</option><option>Mathematical Literacy</option><option>Physical Sciences</option><option>Life Sciences</option><option>Accounting</option></select><span asp-validation-for="Subject" class="text-danger small"></span></div><div class="col-12"><label class="form-label fw-bold">3. Assessment type</label><div class="row g-3"><div class="col-sm-6"><label class="selection-card d-block"><input asp-for="AssessmentType" type="radio" value="June Examination"/>June Examination <span class="d-block small text-muted mt-1">Check your mid-year readiness.</span></label></div><div class="col-sm-6"><label class="selection-card d-block"><input asp-for="AssessmentType" type="radio" value="Final Examination"/>Final Examination <span class="d-block small text-muted mt-1">Prepare for your final assessment.</span></label></div></div><span asp-validation-for="AssessmentType" class="text-danger small"></span></div><div class="col-md-6"><label class="form-label fw-bold">4. Questions</label><div class="d-flex gap-2 flex-wrap">@foreach(var count in new[]{10,20,40}){<input asp-for="QuestionCount" type="radio" class="btn-check" value="@count" id="q@count"/><label class="btn btn-outline-primary" for="q@count">@count questions</label>}</div></div><div class="col-md-6"><label class="form-label fw-bold">5. Time mode</label><div class="d-flex gap-3"><label class="selection-card flex-fill"><input asp-for="TimeMode" type="radio" value="Timed"/> Timed</label><label class="selection-card flex-fill"><input asp-for="TimeMode" type="radio" value="Practice Mode"/> Practice</label></div></div></div><button type="submit" class="btn btn-primary btn-lg w-100 mt-5">Start diagnostic <i class="bi bi-arrow-right ms-1"></i></button></form></div></div></div>
