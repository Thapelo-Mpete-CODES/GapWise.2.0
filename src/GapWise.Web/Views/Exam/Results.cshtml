@model GapWise.Web.ViewModels.AssessmentResultsViewModel
@{ ViewData["Title"]="Assessment Results"; Layout="_Layout"; var result=Model.Result; var passed=result.Percentage>=50; var improvementTopics=string.Join(", ",result.TopicPerformance.Where(topic=>topic.NeedsImprovement).Select(topic=>topic.Topic)); }
<div class="container py-4 py-md-5"><header class="text-center mx-auto mb-5" style="max-width:45rem"><p class="eyebrow text-success">Assessment complete</p><h1 class="display-6 fw-bold">Your diagnostic insights are ready</h1><p class="lead text-muted mb-0">Here’s a clear picture of your Mathematics performance and what to do next.</p></header><section class="hero-panel p-4 p-md-5 mb-4"><div class="row align-items-center g-4"><div class="col-md-7"><p class="eyebrow">Your overall score</p><div class="d-flex align-items-end gap-3"><span class="display-2 fw-bold">@result.Percentage%</span><span class="mb-3 badge @(passed ? "text-bg-success" : "text-bg-warning")">@(passed ? "Pass" : "Keep building")</span></div><p class="text-muted mb-0">@result.TotalScore out of @result.TotalQuestions questions · @result.PerformanceLevel</p></div><div class="col-md-5"><div class="bg-white bg-opacity-10 rounded-4 p-3"><div class="progress mb-2"><div class="progress-bar @(result.Percentage<40?"bg-danger":result.Percentage<75?"bg-warning":"bg-success")" style="width:@result.Percentage%"></div></div><span class="small text-white-50">Diagnostic performance</span></div></div></div></section><div class="row g-3 mb-4"><div class="col-sm-6"><article class="premium-card p-4 h-100"><span class="feature-icon text-success"><i class="bi bi-check2-circle"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">Correct answers</p><p class="h2 fw-bold mb-0 text-success">@result.CorrectAnswers</p></article></div><div class="col-sm-6"><article class="premium-card p-4 h-100"><span class="feature-icon text-warning"><i class="bi bi-arrow-repeat"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">To revisit</p><p class="h2 fw-bold mb-0">@result.IncorrectAnswers</p></article></div></div><section class="premium-card p-4 p-md-5 mb-4"><div class="row g-4"><div class="col-lg-8"><p class="eyebrow">Performance summary</p><h2 class="h3">Your next best learning step</h2><p class="text-muted">@result.SubjectFeedback Reviewing weaker topics now will help you turn diagnostic insight into stronger exam performance.</p><p class="mb-4"><strong>Topics needing attention:</strong> @(string.IsNullOrEmpty(improvementTopics)?"None — keep up the excellent work.":improvementTopics)</p><a class="btn btn-primary" asp-controller="Learning" asp-action="Topic" asp-route-id="@result.WeakestTopic"><i class="bi bi-journal-bookmark me-1"></i>Learn @result.WeakestTopic</a></div><div class="col-lg-4"><div class="rounded-4 bg-light p-4 mb-3"><i class="bi bi-award text-success fs-4"></i><p class="small text-muted mb-1 mt-2">Strongest topic</p><strong>@result.StrongestTopic</strong></div><div class="rounded-4 bg-light p-4"><i class="bi bi-bullseye text-primary fs-4"></i><p class="small text-muted mb-1 mt-2">Focus next</p><strong>@result.WeakestTopic</strong></div></div></div></section><section class="mb-5"><div class="d-flex justify-content-between align-items-end mb-3"><div><p class="eyebrow mb-1">Topic breakdown</p><h2 class="h3 mb-0">See your performance by topic</h2></div></div><div class="row g-3">@foreach(var topic in result.TopicPerformance){<div class="col-md-6"><article class="premium-card p-4 h-100"><div class="d-flex justify-content-between"><h3 class="h5">@topic.Topic</h3><span class="badge @(topic.NeedsImprovement?"text-bg-warning":"text-bg-success")">@topic.Percentage%</span></div><p class="small text-muted">@topic.CorrectAnswers of @topic.TotalQuestions correct</p><div class="progress"><div class="progress-bar @(topic.NeedsImprovement?"bg-warning":"bg-success")" style="width:@topic.Percentage%"></div></div></article></div>}</div></section><section><p class="eyebrow mb-1">Personalised pathway</p><h2 class="h3 mb-3">Recommended for you</h2><div class="row g-3">@foreach(var recommendation in result.Recommendations){<div class="col-md-6"><article class="premium-card p-4 h-100"><span class="topic-accent"><i class="bi @(recommendation.NeedsImprovement?"bi-lightbulb":"bi-rocket-takeoff")"></i></span><h3 class="h5 mt-3">@recommendation.Topic</h3><p class="text-muted">@recommendation.Message</p><a class="btn btn-outline-primary btn-sm" asp-controller="Learning" asp-action="Topic" asp-route-id="@recommendation.Topic">Open lesson <i class="bi bi-arrow-right"></i></a></article></div>}</div><div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-5"><a class="btn btn-primary" asp-controller="Exam" asp-action="Index"><i class="bi bi-arrow-repeat me-1"></i>Retake assessment</a><a class="btn btn-outline-primary" asp-controller="Exam" asp-action="History"><i class="bi bi-clock-history me-1"></i>View history</a></div></section></div>
