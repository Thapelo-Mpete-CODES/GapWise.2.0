@model GapWise.Web.ViewModels.AssessmentViewModel
@{ ViewData["Title"] = "Mathematics Diagnostic"; Layout = "_Layout"; }
<div class="container py-4 py-md-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow mb-1">Mathematics diagnostic</p><h1 class="h3 mb-0">Focus. Think. Progress.</h1></div><span class="badge text-bg-light border text-muted"><i class="bi bi-shield-check me-1"></i>Answers save as you go</span></div><div class="row g-4"><div class="col-lg-8 order-2 order-lg-1"><form id="assessmentForm" asp-action="Submit" asp-controller="Exam" method="post" class="premium-card overflow-hidden">@Html.AntiForgeryToken()<div class="p-4 p-md-5">@for (var index = 0; index < Model.Questions.Count; index++){var question = Model.Questions[index];<section class="question-panel @(index == 0 ? string.Empty : "d-none")" data-question-index="@index"><div class="d-flex align-items-center gap-2 mb-3"><span class="topic-accent"><i class="bi bi-question-lg"></i></span><div><p class="eyebrow mb-0">Question @(index + 1) of @Model.Questions.Count</p><span class="small text-muted">Choose the best answer</span></div></div><h2 class="h3 mb-4">@question.Text</h2><div class="vstack gap-3">@foreach (var option in question.Options){var optionId = $"question{question.Id}{option.Key}";<label class="form-check question-option p-3 p-md-4 mb-0" for="@optionId"><input class="form-check-input" type="radio" name="Answers[@question.Id]" value="@option.Key" id="@optionId"/><span class="form-check-label ms-2"><strong class="text-primary me-2">@option.Key.</strong>@option.Value</span></label>}</div></section>}<div class="d-flex justify-content-between gap-3 border-top mt-5 pt-4"><button type="button" id="previousQuestion" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i>Previous</button><button type="button" id="nextQuestion" class="btn btn-primary">Next <i class="bi bi-arrow-right ms-1"></i></button></div></div></form></div><aside class="col-lg-4 order-1 order-lg-2"><div class="premium-card p-4 position-sticky" style="top:6rem"><div class="d-flex justify-content-between align-items-center"><span class="fw-bold">Assessment progress</span><span id="questionProgress" class="badge text-bg-primary">1 / @Model.Questions.Count</span></div><div class="progress my-3"><div id="progressBar" class="progress-bar" style="width:10%"></div></div><div class="rounded-4 bg-light p-3 mb-3"><div class="d-flex justify-content-between"><span class="text-muted small">Answered</span><strong><span id="answeredCount">0</span> / @Model.Questions.Count</strong></div></div><div class="rounded-4 bg-light p-3 mb-4"><span class="text-muted small d-block">Time remaining</span><strong id="timer" class="h3 text-primary mb-0" aria-live="polite">30:00</strong></div><p class="small fw-bold text-uppercase text-muted">Question navigator</p><div class="d-flex flex-wrap gap-2 mb-4">@for (var index = 0; index < Model.Questions.Count; index++){<button type="button" class="btn btn-outline-secondary navigator-button" data-question-index="@index" aria-label="Go to question @(index + 1)">@(index + 1)</button>}</div><button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#submitConfirmation"><i class="bi bi-send-check me-1"></i>Submit assessment</button></div></aside></div></div><div class="modal fade" id="submitConfirmation" tabindex="-1" aria-labelledby="submitConfirmationTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content premium-card"><div class="modal-body p-4 p-md-5 text-center"><span class="topic-accent mx-auto"><i class="bi bi-send-check"></i></span><h2 class="h4 mt-3" id="submitConfirmationTitle">Ready to submit?</h2><p class="text-muted">You won’t be able to change your answers after submission.</p><div class="d-flex gap-2 justify-content-center mt-4"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Keep reviewing</button><button type="button" id="confirmSubmit" class="btn btn-success">Submit now</button></div></div></div></div></div>
@section Scripts { <script>const panels=Array.from(document.querySelectorAll('.question-panel')),navigatorButtons=Array.from(document.querySelectorAll('.navigator-button')),previousButton=document.getElementById('previousQuestion'),nextButton=document.getElementById('nextQuestion'),progressBar=document.getElementById('progressBar'),questionProgress=document.getElementById('questionProgress'),answeredCount=document.getElementById('answeredCount'),form=document.getElementById('assessmentForm');let currentQuestion=0;function updateAssessment(){panels.forEach((panel,index)=>panel.classList.toggle('d-none',index!==currentQuestion));navigatorButtons.forEach((button,index)=>{button.classList.toggle('btn-primary',index===currentQuestion);button.classList.toggle('btn-outline-secondary',index!==currentQuestion);const answered=document.querySelector(`input[name="Answers[${index+1}]"]:checked`);button.classList.toggle('border-success',Boolean(answered));});const answered=document.querySelectorAll('input[type="radio"]:checked').length;answeredCount.textContent=answered;questionProgress.textContent=`${currentQuestion+1} / ${panels.length}`;progressBar.style.width=`${((currentQuestion+1)/panels.length)*100}%`;previousButton.disabled=currentQuestion===0;nextButton.innerHTML=currentQuestion===panels.length-1?'Review answers <i class="bi bi-check2 ms-1"></i>':'Next <i class="bi bi-arrow-right ms-1"></i>';}previousButton.addEventListener('click',()=>{if(currentQuestion>0){currentQuestion--;updateAssessment();}});nextButton.addEventListener('click',()=>{if(currentQuestion<panels.length-1){currentQuestion++;updateAssessment();}});navigatorButtons.forEach(button=>button.addEventListener('click',()=>{currentQuestion=Number(button.dataset.questionIndex);updateAssessment();}));form.addEventListener('change',updateAssessment);document.getElementById('confirmSubmit').addEventListener('click',()=>form.submit());let remainingSeconds=1800;const timer=document.getElementById('timer'),countdown=window.setInterval(()=>{remainingSeconds--;const minutes=Math.floor(remainingSeconds/60),seconds=remainingSeconds%60;timer.textContent=`${minutes}:${seconds.toString().padStart(2,'0')}`;if(remainingSeconds<=0){window.clearInterval(countdown);form.submit();}},1000);updateAssessment();</script> }
