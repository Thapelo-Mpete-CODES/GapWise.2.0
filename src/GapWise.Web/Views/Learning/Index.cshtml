@model GapWise.Web.ViewModels.LearningHubViewModel
@{ ViewData["Title"]="Learning Hub"; Layout="_Layout"; }
<div class="container py-4 py-md-5"><header class="hero-panel p-4 p-md-5 mb-5"><p class="eyebrow">CAPS learning support</p><h1 class="display-5 fw-bold">Your learning hub</h1><p class="lead text-muted mb-0">Explore guided pathways that turn diagnostic insight into confident progress.</p></header><div class="d-flex justify-content-between align-items-end mb-3"><div><p class="eyebrow mb-1">Choose a subject</p><h2 class="section-heading h2 mb-0">Learn at your pace</h2></div><span class="text-muted small"><i class="bi bi-stars me-1"></i>More subjects coming soon</span></div><section class="row g-4">@foreach(var subject in Model.Subjects){<div class="col-md-6 col-xl-4"><article class="premium-card p-4 h-100 d-flex flex-column"><div class="d-flex justify-content-between align-items-start"><span class="topic-accent"><i class="bi @(subject.IsAvailable ? "bi-calculator" : "bi-book")"></i></span><span class="badge @(subject.IsAvailable ? "text-bg-success" : "text-bg-light border text-muted")">@(subject.IsAvailable ? "Ready to learn" : "Coming soon")</span></div><h2 class="h4 mt-4">@subject.Name</h2><p class="text-muted flex-grow-1">@subject.Description</p>@if(subject.IsAvailable){<a class="btn btn-primary" asp-action="Subject" asp-route-id="Mathematics">Explore Mathematics <i class="bi bi-arrow-right ms-1"></i></a>}else{<button class="btn btn-light text-muted" disabled>Coming soon</button>}</article></div>}</section></div>
