@model GapWise.Web.ViewModels.LearningTopicViewModel
@{ ViewData["Title"]=$"Learn {Model.Name}"; Layout="_Layout"; }
<div class="container py-4 py-md-5"><header class="hero-panel p-4 p-md-5 mb-5"><div class="row align-items-center g-4"><div class="col-lg-8"><p class="eyebrow">Mathematics · @Model.Name</p><h1 class="display-5 fw-bold">Learn @Model.Name</h1><p class="lead text-muted mb-0">@Model.Overview</p></div><div class="col-lg-4 text-lg-end"><span class="badge text-bg-light text-dark me-1">@Model.Difficulty</span><span class="badge text-bg-light text-dark">@Model.StudyTime</span></div></div></header><div class="row g-4"><div class="col-lg-8"><section class="premium-card p-4 p-md-5 mb-4"><div class="d-flex align-items-center gap-3 mb-3"><span class="topic-accent"><i class="bi bi-bullseye"></i></span><div><p class="eyebrow mb-0">Learning goals</p><h2 class="h3 mb-0">What you’ll be able to do</h2></div></div><ul class="mb-0 ps-3">@foreach(var objective in Model.LearningObjectives){<li class="mb-2">@objective</li>}</ul></section><section class="premium-card p-4 p-md-5 mb-4"><div class="d-flex align-items-center gap-3 mb-3"><span class="topic-accent"><i class="bi bi-diagram-3"></i></span><div><p class="eyebrow mb-0">Core knowledge</p><h2 class="h3 mb-0">Key concepts</h2></div></div><div class="row g-3">@foreach(var concept in Model.KeyConcepts){<div class="col-md-6"><div class="rounded-4 bg-light p-3 h-100"><i class="bi bi-check2 text-primary me-2"></i>@concept</div></div>}</div></section><section class="premium-card p-4 p-md-5 mb-4"><div class="d-flex align-items-center gap-3 mb-3"><span class="topic-accent"><i class="bi bi-pencil-square"></i></span><div><p class="eyebrow mb-0">See it in action</p><h2 class="h3 mb-0">Worked example</h2></div></div><div class="callout p-4"><p class="mb-0">@Model.WorkedExample</p></div></section><section class="premium-card p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-3"><span class="topic-accent"><i class="bi bi-bookmark-star"></i></span><div><p class="eyebrow mb-0">Takeaway</p><h2 class="h3 mb-0">Lesson summary</h2></div></div><p class="mb-0">@Model.Summary</p></section></div><aside class="col-lg-4"><div class="position-sticky" style="top:6rem"><section class="premium-card p-4 mb-4"><h2 class="h5"><i class="bi bi-lightbulb text-warning me-2"></i>Study tips</h2><ul class="small text-muted mb-0 ps-3">@foreach(var tip in Model.StudyTips){<li class="mb-2">@tip</li>}</ul></section><section class="premium-card p-4 mb-4"><h2 class="h5"><i class="bi bi-mortarboard text-primary me-2"></i>Exam tips</h2><ul class="small text-muted mb-0 ps-3">@foreach(var tip in Model.ExamTips){<li class="mb-2">@tip</li>}</ul></section><section class="premium-card p-4 mb-4"><h2 class="h5"><i class="bi bi-exclamation-circle text-danger me-2"></i>Common mistakes</h2><ul class="small text-muted mb-0 ps-3">@foreach(var mistake in Model.CommonMistakes){<li class="mb-2">@mistake</li>}</ul></section><section class="premium-card p-4"><h2 class="h5"><i class="bi bi-collection-play text-primary me-2"></i>Learning resources</h2><p class="small text-muted">Extend today’s lesson with these resources.</p><a class="btn btn-primary w-100 mb-2" href="@Model.VideoUrl" target="_blank" rel="noopener"><i class="bi bi-play-circle me-1"></i>Watch recommended video</a><button class="btn btn-outline-primary w-100 mb-2" disabled><i class="bi bi-download me-1"></i>Study notes · Soon</button><button class="btn btn-outline-primary w-100 mb-2" disabled><i class="bi bi-file-earmark-text me-1"></i>Formula sheet · Soon</button><button class="btn btn-outline-primary w-100" disabled><i class="bi bi-patch-question me-1"></i>Practice quiz · Soon</button></section></div></aside></div></div>
