@model GapWise.Web.ViewModels.LearningSubjectViewModel
@{ ViewData["Title"]=$"{Model.Subject} Learning"; Layout="_Layout"; }
<div class="container py-4 py-md-5"><header class="mb-5"><p class="eyebrow">@Model.Subject learning pathway</p><h1 class="display-5 fw-bold">Build your @Model.Subject confidence</h1><p class="lead text-muted">Choose a topic for clear concepts, worked examples, and practical exam guidance.</p></header><div class="row g-4">@foreach(var topic in Model.Topics){<div class="col-md-6"><article class="premium-card p-4 h-100"><div class="d-flex justify-content-between align-items-start"><span class="topic-accent"><i class="bi bi-diagram-3"></i></span><span class="badge text-bg-light border text-muted">@topic.Difficulty</span></div><h2 class="h4 mt-4">@topic.Name</h2><p class="text-muted">@topic.Description</p><div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4"><span class="small text-muted"><i class="bi bi-clock me-1"></i>@topic.StudyTime</span><a class="btn btn-primary btn-sm" asp-action="Topic" asp-route-id="@topic.Name">Start topic <i class="bi bi-arrow-right"></i></a></div></article></div>}</div></div>
