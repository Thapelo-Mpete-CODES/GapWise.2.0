@model GapWise.Web.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Welcome back"; Layout = "_AuthLayout"; }
<main class="container-fluid"><div class="row min-vh-100"><section class="col-lg-6 d-none d-lg-flex auth-brand p-5 flex-column justify-content-between"><a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-white" asp-controller="Home" asp-action="Index"><span class="brand-mark bg-white text-primary">G</span>GapWise</a><div class="mx-auto" style="max-width:30rem"><p class="eyebrow text-white">Smarter CAPS support</p><h1 class="display-5 fw-bold">Every gap is a chance to grow.</h1><p class="lead text-muted">Turn your assessment results into a clear, confidence-building learning path.</p><div class="d-flex gap-3 mt-4"><i class="bi bi-graph-up-arrow fs-2"></i><span><strong>See your next best step</strong><br/>Personalised diagnostic insights, built for you.</span></div></div><p class="small text-muted">South African CAPS learners, moving forward.</p></section><section class="col-lg-6 d-flex align-items-center justify-content-center p-4 p-md-5"><div style="width:100%;max-width:27rem"><a class="d-lg-none navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 mb-5" asp-controller="Home" asp-action="Index"><span class="brand-mark">G</span>GapWise</a><p class="eyebrow">Welcome back</p><h1 class="display-6 fw-bold mb-2">Sign in to continue</h1><p class="text-muted mb-4">Pick up where your learning journey left off.</p><form asp-action="Login" asp-controller="Account" method="post" novalidate class="premium-card p-4 p-md-5">@Html.AntiForgeryToken()<input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div><div class="mb-3"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label fw-semibold"></label><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password"/><span asp-validation-for="Password" class="text-danger small"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label text-muted"></label></div><button type="submit" class="btn btn-primary w-100">Sign in <i class="bi bi-arrow-right ms-1"></i></button></form><p class="text-center text-muted mt-4">New to GapWise? <a class="fw-bold text-decoration-none" asp-action="Register">Create an account</a></p></div></section></div></main>
