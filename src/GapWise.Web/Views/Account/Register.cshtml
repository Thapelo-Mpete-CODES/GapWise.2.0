@model GapWise.Web.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; Layout = "_AuthLayout"; }
<main class="container-fluid"><div class="row min-vh-100"><section class="col-lg-5 d-none d-lg-flex auth-brand p-5 flex-column justify-content-between"><a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-white" asp-controller="Home" asp-action="Index"><span class="brand-mark bg-white text-primary">G</span>GapWise</a><div><p class="eyebrow text-white">Start your journey</p><h1 class="display-5 fw-bold">Your learning, made more personal.</h1><p class="lead text-muted">Discover what to focus on and build exam confidence one topic at a time.</p></div><div class="small text-muted"><i class="bi bi-check2-circle me-2"></i>Free diagnostic assessment<br/><i class="bi bi-check2-circle me-2"></i>CAPS-aligned learning pathways</div></section><section class="col-lg-7 d-flex align-items-center justify-content-center p-4 p-md-5"><div style="width:100%;max-width:37rem"><a class="d-lg-none navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 mb-4" asp-controller="Home" asp-action="Index"><span class="brand-mark">G</span>GapWise</a><p class="eyebrow">Create your learner profile</p><h1 class="display-6 fw-bold mb-2">Let’s get you started</h1><p class="text-muted mb-4">It takes less than a minute.</p><form asp-action="Register" asp-controller="Account" method="post" novalidate class="premium-card p-4 p-md-5">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label fw-semibold"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name"/><span asp-validation-for="FirstName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LastName" class="form-label fw-semibold"></label><input asp-for="LastName" class="form-control" autocomplete="family-name"/><span asp-validation-for="LastName" class="text-danger small"></span></div><div class="col-12"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Password" class="form-label fw-semibold"></label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label fw-semibold"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div></div><button type="submit" class="btn btn-primary w-100 mt-4">Create my account <i class="bi bi-arrow-right ms-1"></i></button></form><p class="text-center text-muted mt-4">Already have an account? <a class="fw-bold text-decoration-none" asp-action="Login">Sign in</a></p></div></section></div></main>
