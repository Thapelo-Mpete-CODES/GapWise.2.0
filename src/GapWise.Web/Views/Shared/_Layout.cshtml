<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · GapWise</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" /></head><body><nav class="navbar navbar-expand-lg app-navbar sticky-top border-bottom"><div class="container py-2"><a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">G</span>GapWise</a><button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNavigation"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Learning" asp-action="Index"><i class="bi bi-journal-bookmark me-1"></i>Learn</a></li><li class="nav-item"><a class="nav-link" asp-controller="Exam" asp-action="History"><i class="bi bi-clock-history me-1"></i>History</a></li><li class="nav-item"><a class="nav-link" asp-controller="Teacher" asp-action="Index"><i class="bi bi-easel2 me-1"></i>Teacher <span class="badge text-bg-light border text-muted">Preview</span></a></li><li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm" asp-controller="Exam" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1"></i>Assessment</a></li><li class="nav-item ms-lg-1"><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-light btn-sm" type="submit" aria-label="Log out"><i class="bi bi-box-arrow-right"></i></button></form></li></ul></div></div></nav><main class="app-main">@RenderBody()</main><footer class="footer"><div class="container py-4 d-flex flex-column flex-sm-row justify-content-between gap-2"><span>© @DateTime.UtcNow.Year GapWise · CAPS learning made personal.</span><span>Diagnose. Learn. Improve.</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
