@{ ViewData["Title"] = "Teacher Dashboard Preview"; Layout = "_Layout"; }
<div class="container py-4 py-md-5"><header class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="eyebrow">Product roadmap · educator experience</p><h1 class="display-6 fw-bold mb-1">Teacher Dashboard Preview <span class="badge text-bg-primary align-middle fs-6">Preview</span></h1><p class="lead text-muted mb-0">A glimpse of how GapWise will support classroom insight and targeted intervention.</p></div><span class="badge text-bg-light border text-muted"><i class="bi bi-eye me-1"></i>Presentation preview</span></header><section class="premium-card p-4 mb-4" role="note"><div class="d-flex gap-3"><span class="topic-accent flex-shrink-0"><i class="bi bi-info-circle"></i></span><div><h2 class="h6 mb-1">Future teacher capabilities</h2><p class="text-muted mb-0">This interface is a non-functional preview demonstrating planned teacher capabilities in future versions of GapWise. The current MVP focuses on the learner experience.</p></div></div></section><section class="row g-3 mb-5">@foreach(var metric in new[]{("bi-bar-chart","Class average","68%",""),("bi-people","Learners","42",""),("bi-clipboard2-check","Completed","39",""),("bi-person-exclamation","Need support","11","text-warning"),("bi-trophy","Highest score","96%","text-success"),("bi-flag","Lowest score","34%","text-danger")}){<div class="col-6 col-lg-4 col-xl-2"><article class="premium-card metric-card p-3 h-100"><span class="metric-icon"><i class="bi @metric.Item1"></i></span><p class="small text-muted text-uppercase fw-bold mt-3 mb-1">@metric.Item2</p><p class="metric-value h2 fw-bold mb-0 @metric.Item4">@metric.Item3</p></article></div>}</section><section class="mb-5"><p class="eyebrow mb-1">Class insights</p><h2 class="h3 mb-3">Performance at a glance</h2><div class="row g-3">@foreach(var insight in new[]{("bi-speedometer2","Average performance","68%","68",""),("bi-check2-square","Completion rate","93%","93","bg-success"),("bi-person-check","Participation","88%","88","bg-info"),("bi-graph-up-arrow","Improvement trend","+12%","12","bg-success")}){<div class="col-md-6 col-xl-3"><article class="premium-card p-4 h-100"><div class="d-flex justify-content-between"><span class="topic-accent"><i class="bi @insight.Item1"></i></span><strong>@insight.Item3</strong></div><h3 class="h6 mt-3">@insight.Item2</h3><div class="progress"><div class="progress-bar @insight.Item5" style="width:@insight.Item4%"></div></div></article></div>}</div></section><div class="row g-4 mb-5"><div class="col-lg-7"><section class="premium-card p-4 h-100"><p class="eyebrow mb-1">Topic performance</p><h2 class="h3 mb-3">Where the class needs focus</h2><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Topic</th><th>Class average</th><th>Performance</th></tr></thead><tbody><tr><td><strong>Algebra</strong></td><td>42%</td><td><span class="badge text-bg-danger">Needs attention</span></td></tr><tr><td><strong>Functions</strong></td><td>84%</td><td><span class="badge text-bg-success">Good</span></td></tr><tr><td><strong>Geometry</strong></td><td>69%</td><td><span class="badge text-bg-warning">Moderate</span></td></tr><tr><td><strong>Trigonometry</strong></td><td>47%</td><td><span class="badge text-bg-danger">Needs attention</span></td></tr><tr><td><strong>Accounting</strong> <span class="badge text-bg-light border text-muted">Preview</span></td><td>—</td><td><span class="badge text-bg-light border text-muted">Coming soon</span></td></tr></tbody></table></div></section></div><div class="col-lg-5"><section class="premium-card p-4 h-100"><p class="eyebrow mb-1">Recommended interventions</p><h2 class="h3 mb-3">Suggested next actions</h2><div class="vstack gap-3"><div class="rounded-4 bg-light p-3"><i class="bi bi-lightbulb text-warning me-2"></i><strong>Revisit Algebra</strong><p class="small text-muted mb-0 mt-1">Most learners struggled with Algebra. Schedule a revision lesson before the next assessment.</p></div><div class="rounded-4 bg-light p-3"><i class="bi bi-graph-up-arrow text-success me-2"></i><strong>Keep the Geometry strategy</strong><p class="small text-muted mb-0 mt-1">Geometry performance is improving. Continue with the current teaching approach.</p></div><div class="rounded-4 bg-light p-3"><i class="bi bi-pencil-square text-primary me-2"></i><strong>Add Trigonometry practice</strong><p class="small text-muted mb-0 mt-1">Provide additional practice exercises ahead of the next diagnostic.</p></div></div></section></div></div><section class="mb-5"><p class="eyebrow mb-1">Learner support</p><h2 class="h3 mb-3">Learners needing attention</h2><div class="premium-card overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Learner</th><th>Weak topic</th><th>Current score</th><th>Priority</th></tr></thead><tbody><tr><td><strong>Student A</strong></td><td>Algebra</td><td>42%</td><td><span class="badge text-bg-danger">High</span></td></tr><tr><td><strong>Student B</strong></td><td>Trigonometry</td><td>39%</td><td><span class="badge text-bg-danger">High</span></td></tr><tr><td><strong>Student C</strong></td><td>Geometry</td><td>55%</td><td><span class="badge text-bg-warning">Medium</span></td></tr><tr><td><strong>Student D</strong></td><td>Functions</td><td>61%</td><td><span class="badge text-bg-light border text-muted">Monitor</span></td></tr></tbody></table></div></div></section><section><div class="d-flex align-items-end justify-content-between mb-3"><div><p class="eyebrow mb-1">Roadmap</p><h2 class="h3 mb-0">Teacher tools coming soon</h2></div><span class="badge text-bg-light border text-muted">Preview only</span></div><div class="row g-3">@foreach(var feature in new[]{("bi-plus-circle","Create Assessment"),("bi-people","Manage Classes"),("bi-envelope-paper","Parent Reports"),("bi-download","Export Analytics"),("bi-file-earmark-pdf","Download PDF Reports"),("bi-buildings","District Dashboard"),("bi-diagram-2","School Comparison"),("bi-stars","Predictive Insights")}){<div class="col-6 col-md-4 col-xl-3"><article class="premium-card p-3 h-100 opacity-75"><span class="topic-accent"><i class="bi @feature.Item1"></i></span><h3 class="h6 mt-3 mb-1">@feature.Item2</h3><span class="badge text-bg-light border text-muted">Coming soon</span></article></div>}</div></section></div>
